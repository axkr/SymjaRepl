	<classpathentry combineaccessrules="false" kind="src" path="/matheclipse-gpl"/>
	<classpathentry combineaccessrules="false" kind="src" path="/matheclipse-logging"/>
	<classpathentry combineaccessrules="false" kind="src" path="/matheclipse-parser"/>
